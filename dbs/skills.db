; =============================================================
; skills_minecraft_candidate.db
; First Minecraft-RPG adaptation of the original skills.db
; English section/key names are intentionally retained where possible,
; because the existing mIRC source code refers to them.
;
; IMPORTANT:
; - This is a compatibility-minded candidate, not a blind rewrite.
; - Cost/CoinCost/ActionPoints/Style fields are retained until their
;   exact old core-code meaning and dependencies are reviewed.
; - PARKED skills are documented in skills_review.md and are not active here.
; - New Minecraft KillerTraits should only be added after MonsterType/core
;   checks are defined, so no unsupported new keys are invented here.
; =============================================================


; =============================================================
; PASSIVE SKILLS - KEPT / ADAPTED
; =============================================================

[Swordmaster]
Cost=150
CoinCost=500
Max=$iif($readini($char($1), stuff, NumberOfResets) >= 1, 150, 100)
Type=Passive
Info=This skill increases damage done with sword and katana weapons.  Increased levels increases the damage.

[Polemaster]
Cost=150
CoinCost=5
Max=$iif($readini($char($1), stuff, NumberOfResets) >= 1, 150, 100)
Type=Passive
Info=This skill increases damage done with spear weapons.  Increased levels increases the damage.

