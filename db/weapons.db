;;;;===== WeaponDisplayTitle
; Dieser Bereich ist auschlieslich nur für die Auflistung später unter !weapons bzw Tools
; Hierbei ist Keyname der englische wert und der Wert dahinter die Übersetzung
;
; MechWeapons wurden bewusst nicht übernommen. Das Feld EnergyCost bleibt im 1:1 Detailtemplate
; erhalten, wird in diesem Minecraft-RPG derzeit aber nicht verwendet.

[WeaponDisplayTitles]
Swords=Schwerter
LongSwords=Langschwerter
GreatSwords=Großschwerter
Daggers=Dolche
Spears=Speere
Tridents=Dreizacke
Axes=Äxte
BattleAxes=Streitäxte
Maces=Streitkolben
Hammers=Kriegshämmer
Scythes=Sensen
Bows=Bögen
Crossbows=Armbrüste
Staves=Stäbe
Wands=Zauberstäbe
MonsterWeapons=Monsterwaffen

;;;;; === Weapons
;;; Der Key entspricht dem Type-Wert der jeweiligen Waffe.
;;; Mehrere Waffen werden mit einem Punkt voneinander getrennt.
;;; Abilities verweisen ausschließlich auf vorhandene Einträge in techniques.db.

[Weapons]
Swords=WoodenSword.StoneSword.IronSword.GoldenSword.DiamondSword.NetheriteSword.ObsidianSword.EmeraldBlade
LongSwords=IronLongsword.GoldenLongsword.DiamondLongsword.NetheriteLongsword.Frostbrand.EmberEdge.GaleLongsword.MistwalkerBlade
GreatSwords=StoneGreatsword.IronGreatsword.GoldenGreatsword.DiamondGreatsword.NetheriteGreatsword.ObsidianCleaver.MagmaGreatblade.AncientDeepblade
Daggers=FlintDagger.IronDagger.GoldenDagger.DiamondDagger.NetheriteDagger.TwinFang.TwinClaw.WispNeedle
Spears=WoodenSpear.StoneSpear.IronSpear.GoldenSpear.DiamondSpear.NetheriteSpear.FrostPike.Rootpiercer
Tridents=Trident.CoralTrident.DrownedTrident.PrismarineTrident.StormTrident.TidalTrident.AbyssalTrident.GuardianTrident
Axes=WoodenAxe.StoneAxe.IronAxe.GoldenAxe.DiamondAxe.NetheriteAxe.LumberjackAxe.EmberAxe
BattleAxes=IronBattleAxe.GoldenBattleAxe.DiamondBattleAxe.NetheriteBattleAxe.ObsidianBattleAxe.RavagerAxe.Frostcleaver.NetherExecutioner
Maces=StoneMace.IronMace.GoldenMace.DiamondMace.NetheriteMace.BreezeMace.WindburstMace.AncientTrialMace
Hammers=StoneWarhammer.IronWarhammer.GoldenWarhammer.DiamondWarhammer.NetheriteWarhammer.ObsidianHammer.MagmaHammer.DeepstoneMaul
Scythes=IronScythe.GoldenScythe.DiamondScythe.NetheriteScythe.HarvestScythe.SoulScythe.FogReaper.WitherScythe
Bows=ShortBow.OakBow.ReinforcedBow.GoldenBow.HunterBow.LongBow.FrostBow.EnderBow
Crossbows=WoodenCrossbow.IronCrossbow.GoldenCrossbow.ReinforcedCrossbow.PiercingCrossbow.NetherCrossbow.StormCrossbow.AncientCrossbow
Staves=OakStaff.StoneStaff.IronwoodStaff.BlazeStaff.FrostStaff.TideStaff.StormStaff.EnderStaff
Wands=WoodenWand.CopperWand.GoldWand.AmethystWand.BlazeWand.FrostWand.WispWand.VoidWand
MonsterWeapons=ZombieClaws.SkeletonBoneBow.SpiderFangs.CreeperBlast.RootLurkerLimbs.WispLight.WardenSonicPulse.BlazeFireCore

;===== Schilde
;; Schilde besitzen weiterhin ihre eigene Section.
;; Die Schildstruktur wird erst gemeinsam befüllt, wenn wir sie fachlich besprochen haben.
[Shields]
Large=
Small=
Medium=

